rules_version = '2';

// Zugriffsregeln für den gemeinsamen Warenkorb.
//
// Grundidee:
//  - Es muss eine (anonyme) Anmeldung vorliegen. Die passiert in der App
//    unsichtbar und dient nur dazu, jedem Gerät eine stabile Kennung zu geben.
//  - Anlegen nur unter eigener Kennung; Mengen ändern nur an eigenen
//    Positionen. So kann niemand die Bestellung anderer verfälschen.
//  - Entfernen darf jeder in der Runde – damit Tippfehler und Positionen
//    von Kollegen, die schon weg sind, aufgeräumt werden können.
//  - Die gemeinsamen Einstellungen einer Runde (20 % Rabatt, Anzahl der
//    Essensmarken und deren Verteilung) darf jeder in der Runde anpassen.
//  - Runden werden nie gelöscht; die Kennung ist der jeweilige Tag.
//
// In der Firebase-Konsole einzufügen unter:
//   Firestore Database  ->  Regeln  ->  Inhalt ersetzen  ->  Veröffentlichen

service cloud.firestore {
  match /databases/{database}/documents {

    match /rounds/{roundId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      match /items/{itemId} {
        allow read: if request.auth != null;

        // Anlegen nur unter eigener Kennung
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;

        // Ändern nur eigene Positionen, und die Kennung darf nicht wechseln
        allow update: if request.auth != null
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;

        // Entfernen darf jeder in der Runde (Aufräumen)
        allow delete: if request.auth != null;
      }
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
